# 问答模型（OpenAI 兼容接口）
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60

# 本地模型切换（不改写现有 .env；先运行 scripts/setup_local_llm.ps1 完成部署）
# 启动前在 shell 中 export/set 以下环境变量，仅对当前启动进程及其子进程生效：
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_ID=enterprise-kb-qwen35:4b
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT=180
# KB_RERANK_MODE=crossencoder
# 回滚 DeepSeek：关闭本地启动的项目进程后，重新使用上面的 DeepSeek 配置启动。

# 服务
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
KB_LOG_LEVEL=INFO

# 知识库与本地向量模型
KB_EMBEDDING_MODE=bge_m3
KB_EMBEDDING_MODEL=bge-m3
KB_OLLAMA_HOST=http://127.0.0.1:11434
KB_CHROMA_DIR=./chroma_data
KB_COLLECTION=enterprise_kb
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
KB_CHUNK_PROFILE=structured
KB_TOP_K=5
KB_RECALL_K=20
KB_MAX_HITS_PER_DOC=3
# 需要先用真实评测集校准；0 表示暂不按向量分数过滤
KB_MIN_SIMILARITY=0
# crossencoder 需安装 fastembed；首次加载会下载 BAAI/bge-reranker-base，未安装时会安全降级
KB_RERANK_MODE=llm
KB_RERANK_MODEL=BAAI/bge-reranker-base
# 本地模型启动时通过环境变量改为：KB_RERANK_MODE=crossencoder
# 旧索引重建完成后再开启；开启前保持 0 可直接回滚到单层切片
KB_PARENT_CHILD_ENABLED=0
KB_PARENT_CHUNK_SIZE=1600
KB_NEIGHBOR_EXPANSION=1
KB_ANSWERABILITY_SCORE=0.6

# 权限与限流（生产环境必须配置）
ADMIN_API_KEY=replace-with-a-strong-random-key
KB_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-strong-admin-token
KB_REQUIRE_TOKEN=1
KB_OPEN_SIGNUP=0
# 1=即使在开发环境也强制执行 public/internal 边界；生产环境始终自动强制
KB_ENFORCE_KB_VISIBILITY=0
KB_TOKEN_TTL_DAYS=90
KB_ASK_RATE_LIMIT=20
KB_MAX_UPLOAD_MB=50

# 文档同步、客服 SLA 与数据生命周期
# 文件数据源只能读取此目录；HTTP 数据源必须是下列 HTTPS 域名
KB_SYNC_ALLOWED_ROOT=./sync_sources
KB_SYNC_ALLOWED_HOSTS=
KB_AGENT_SLA_MINUTES=10
KB_ALERT_WAITING_COUNT=20
KB_ALERT_MIN_FREE_GB=2
# 生产环境会自动清理到期数据；开发环境设 1 可启用
KB_AUTO_RETENTION=0
KB_BACKUP_SIGNING_KEY=
KB_REQUIRE_BACKUP_SIGNATURE=1

# 百度 OCR（可选；留空则只使用本地 OCR）
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# KB_BAIDU_OCR_QPS=2
# KB_OCR_FALLBACK_CONFIDENCE=0.6
